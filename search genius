import { serve } from "https://deno.land/std@0.168.0/http/server.ts";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type, x-supabase-client-platform, x-supabase-client-platform-version, x-supabase-client-runtime, x-supabase-client-runtime-version",
};

const SYSTEM_PROMPT = `You are **Search Genius** by Proxima Partners — a futuristic, lightning-fast AI fusing Claude's depth, Grok's edge, Manus's autonomy, and ChatGPT's precision.

## Core rules
- **Lead with the answer.** First sentence = the real answer. Then expand. No throat-clearing, no restating the question, no "Great question!".
- **Be vivid.** Concrete examples, numbers, analogies. Make every reply feel like a glimpse of the future.
- **Format for the eye.** Markdown: **bold** key terms, short paragraphs, bullet lists, tables for comparisons, fenced code with language tags. Tasteful section emoji (🎯 📊 💡 ⚡ 🔬 ✅) — never overdo it.
- **Be autonomous.** For plans/docs/code/analysis, ship the complete deliverable immediately, then offer refinements. Don't ask "what do you want?" — make the best version.
- **Honor instructions exactly.** Persona, tone, format, language, length — adopt and keep it. Most-recent instruction wins.
- **Be honest.** Distinguish facts vs inference, admit uncertainty briefly, self-correct openly.

## Response shape
- Simple question → tight paragraph, then optional details.
- Complex question → bold headline answer → sections/bullets → "Next steps" if useful.
- Code → fenced blocks with language. Production-grade, lightly commented.

Brilliant, direct, futuristic. Treat the user as smart. Never bloated.`;


const IMAGE_KEYWORDS = [
  "generate an image", "create an image", "draw", "make an image",
  "generate a picture", "create a picture", "make a picture",
  "generate art", "create art", "make art",
  "illustrate", "sketch", "paint",
  "show me an image", "show me a picture",
  "image of", "picture of", "photo of",
  "generate image", "create image", "make image",
  "draw me", "design an image", "visualize",
  "generate a photo", "create a photo",
];

function isImageRequest(messages: { role: string; content: string }[]): boolean {
  const lastUserMsg = [...messages].reverse().find(m => m.role === "user");
  if (!lastUserMsg) return false;
  const lower = lastUserMsg.content.toLowerCase();
  return IMAGE_KEYWORDS.some(kw => lower.includes(kw));
}

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response(null, { headers: corsHeaders });
  }

  try {
    const { messages } = await req.json();

    if (!messages || !Array.isArray(messages)) {
      return new Response(
        JSON.stringify({ error: "Messages array is required" }),
        { status: 400, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    const LOVABLE_API_KEY = Deno.env.get("LOVABLE_API_KEY");
    if (!LOVABLE_API_KEY) {
      throw new Error("LOVABLE_API_KEY is not configured");
    }

    // Image generation
    if (isImageRequest(messages)) {
      const lastUserMsg = [...messages].reverse().find(m => m.role === "user");
      const imagePrompt = lastUserMsg?.content || "";

      const response = await fetch("https://ai.gateway.lovable.dev/v1/chat/completions", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${LOVABLE_API_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model: "google/gemini-3.1-flash-image-preview",
          messages: [
            { role: "user", content: `Generate an educational, safe, and appropriate image for: ${imagePrompt}` },
          ],
          modalities: ["image", "text"],
        }),
      });

      if (!response.ok) {
        if (response.status === 429) {
          return new Response(
            JSON.stringify({ error: "Rate limited. Please wait a moment and try again. 📚" }),
            { status: 429, headers: { ...corsHeaders, "Content-Type": "application/json" } }
          );
        }
        if (response.status === 402) {
          return new Response(
            JSON.stringify({ error: "AI credits exhausted. Please add credits in Settings → Workspace → Usage." }),
            { status: 402, headers: { ...corsHeaders, "Content-Type": "application/json" } }
          );
        }
        const t = await response.text();
        console.error("Image generation error:", response.status, t);
        return new Response(
          JSON.stringify({ error: "Failed to generate image. Please try again." }),
          { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }

      const data = await response.json();
      const message = data.choices?.[0]?.message;
      const textContent = message?.content || "Here's the image I generated for you! 🎨";
      const images = message?.images || [];

      return new Response(
        JSON.stringify({
          type: "image",
          content: textContent,
          images: images.map((img: any) => img.image_url?.url || ""),
        }),
        { headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    // Streaming text response — fast Flash model, no extra reasoning latency
    const response = await fetch("https://ai.gateway.lovable.dev/v1/chat/completions", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${LOVABLE_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model: "google/gemini-2.5-flash",
        messages: [
          { role: "system", content: SYSTEM_PROMPT },
          ...messages,
        ],
        stream: true,
        temperature: 0.7,
      }),
    });

    if (!response.ok) {
      if (response.status === 429) {
        return new Response(
          JSON.stringify({ error: "Rate limited. Please wait and try again. 📚" }),
          { status: 429, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }
      if (response.status === 402) {
        return new Response(
          JSON.stringify({ error: "AI credits exhausted. Add credits in Settings → Workspace → Usage." }),
          { status: 402, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }
      const t = await response.text();
      console.error("AI gateway error:", response.status, t);
      return new Response(
        JSON.stringify({ error: "Something went wrong. Please try again." }),
        { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
      );
    }

    return new Response(response.body, {
      headers: { ...corsHeaders, "Content-Type": "text/event-stream" },
    });
  } catch (e) {
    console.error("chat error:", e);
    return new Response(
      JSON.stringify({ error: e instanceof Error ? e.message : "Unknown error" }),
      { status: 500, headers: { ...corsHeaders, "Content-Type": "application/json" } }
    );
  }
});
